# 复制为 .env 并填入真实值（.env 不会被提交到 git）
# 编辑权限由每张地图的邀请码承担，无需全局口令

# Neon 数据库连接串：https://console.neon.tech 创建项目后，在 Dashboard 复制 Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# 高德开放平台「Web端(JS API)」类型的 key 与配套安全密钥：https://console.amap.com
AMAP_KEY=
AMAP_SECURITY_CODE=

# Cloudinary 免费图床（照片存 CDN，数据库只存链接）：https://console.cloudinary.com 的 API Keys
# 不配置时照片会存进数据库（占用 Neon 0.5GB 存储）
CLOUDINARY_URL=

# Web Push 推送（可选）：npx web-push generate-vapid-keys 生成密钥对
# 不配置则 🔔 推送静默停用；网页端（Render）与小程序端（云托管）两侧需配置同一对密钥
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 小程序登录（可选）：mp.weixin.qq.com → 开发管理 → 开发设置 里的 AppID 与 AppSecret
# 配置后小程序所有写操作（加地点/留言/想去/传照片/建图）要求登录，署名用登录昵称
MINIPROGRAM_APPID=
MINIPROGRAM_SECRET=

# 登录 token 签名密钥：openssl rand -base64 32 生成一份固定值（不配则重启后 token 失效）
AUTH_SECRET=

# ---------- 内容安全（UGC 提审要求；配好上面的 AppID/Secret 后自动启用文本检测）----------
# 文本检测：地点名称/描述/地址/标签、留言、昵称写入前调用 security.msgSecCheck
# 图片审核：需要 mp 后台「开发管理 → 消息推送」配置（URL + Token + 明文模式），
#          回调地址填 https://<你的后端域名>/api/wechat/media-check-callback
WECHAT_MSG_TOKEN=
# 设为 off 可临时整体关闭内容安全检测（例如微信接口故障期间）
CONTENT_SECURITY=
# 图片送审时对外可访问的基地址（未配图床时用它拼照片 URL 给微信抓取；默认 Render 域名）
PUBLIC_BASE_URL=
# 举报通知：新举报会 POST 到这个 webhook（企业微信机器人/Server 酱等），不配只写日志
REPORT_WEBHOOK=
