<page-meta page-style="{{themeStyle}}"/><view class="page">
  <!-- 图标生成用隐藏 canvas -->
  <canvas type="2d" id="icon-factory" class="icon-factory"></canvas>

  <!-- 自定义导航栏（右侧避让微信胶囊） -->
  <view class="nav" style="padding-top: {{statusBarHeight}}px; padding-bottom: {{navBottomPad}}px;">
    <view class="nav-row" style="padding-right: {{navRightInset}}px;">
      <view class="nav-title" bindtap="goMapEntry">
        <text class="nav-name">{{mapName}}</text>
        <text class="nav-switch">切换 ▾</text>
      </view>
      <view class="nav-actions">
        <view class="nav-btn" bindtap="goMemories">📷</view>
        <view class="nav-btn" bindtap="goItinerary">🚶</view>
        <view class="nav-btn nav-btn-primary" aria-label="添加地点" bindtap="goSearch">＋</view>
      </view>
    </view>
  </view>

  <!-- 地图（可全屏铺满整屏） -->
  <view class="map-wrap {{isMapFs ? 'map-fs' : ''}}" style="flex: {{mapFraction}};">
    <map
      id="mainMap"
      class="map"
      longitude="{{longitude}}"
      latitude="{{latitude}}"
      scale="12"
      markers="{{markers}}"
      enable-poi="{{true}}"
      show-location="{{showMyDot}}"
      bindmarkertap="onMarkerTap"
    ></map>
    <view class="map-tools">
      <view class="map-tool-btn" bindtap="locateNearby">◎ 附近</view>
      <view class="map-tool-btn map-tool-random" bindtap="drawRandom">🎲 抽一个</view>
      <view class="map-tool-btn" bindtap="toggleMapFs">{{isMapFs ? '✕ 退出' : '⛶ 全屏'}}</view>
    </view>
  </view>

  <view class="map-divider" catchtouchstart="onDividerStart" catchtouchmove="onDividerMove" catchtouchend="onDividerEnd" catchtouchcancel="onDividerCancel">
    <view class="map-divider-grip">⋮⋮</view>
  </view>

  <!-- 底部列表面板 -->
  <view class="panel" style="flex: {{1 - mapFraction}}; height: auto;">
    <view wx:if="{{selectedPlace}}" class="place-preview">
      <view class="preview-emoji">{{selectedPlace.emoji}}</view>
      <view class="preview-main">
        <view class="preview-name">{{selectedPlace.name}}</view>
        <view class="preview-meta">{{selectedPlace.category}}{{selectedPlace.address ? ' · ' + selectedPlace.address : ''}}</view>
        <view wx:if="{{selectedPlace.description}}" class="preview-desc">{{selectedPlace.description}}</view>
      </view>
      <view class="preview-close" catchtap="closePreview">✕</view>
      <view class="btn btn-primary preview-detail" catchtap="openSelectedDetail">查看详情</view>
    </view>
    <view class="filters">
      <scroll-view scroll-x class="chips-scroll">
        <view class="chips">
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="chip {{activeCategories.indexOf(item.id) !== -1 ? 'chip-on' : ''}}"
            style="{{activeCategories.indexOf(item.id) !== -1 ? 'background:' + item.color + '1f; border-color:' + item.color : ''}}"
            data-id="{{item.id}}"
            bindtap="toggleCategory"
          >{{item.emoji}} {{item.id}}</view>
        </view>
      </scroll-view>
      <view class="filters-row">
        <label class="toggle">
          <switch class="toggle-switch" checked="{{hideVisitedOnly}}" bindchange="toggleHideVisited" color="#0f766e" />
          <text>只看还没去的</text>
        </label>
        <picker range="{{['最新添加', '按名称', '最想去']}}" value="{{sortIndex}}" bindchange="onSortChange">
          <text class="sort">排序 ▾</text>
        </picker>
      </view>
    </view>

    <!-- 下拉刷新：页面本身不可滚动（disableScroll），刷新手势收进列表内部 -->
    <scroll-view
      scroll-y
      class="place-scroll"
      refresher-enabled
      refresher-triggered="{{refreshing}}"
      refresher-default-style="{{isDark ? 'white' : 'black'}}"
      bindrefresherrefresh="onRefresherRefresh"
    >
      <!-- 加载失败：错误态 + 重试，不能伪装成「还没有地点」 -->
      <view wx:if="{{loadError}}" class="empty">
        <text class="empty-icon">⚠️</text>
        <text>{{loadError}}</text>
        <view class="btn btn-primary" bindtap="retryLoad">重试</view>
      </view>
      <view wx:elif="{{loading}}" class="empty">
        <text class="empty-icon">🗺️</text>
        <text>正在加载地点…</text>
      </view>
      <view wx:elif="{{filtered.length === 0}}" class="empty">
        <text class="empty-icon">🌃</text>
        <text>{{places.length === 0 ? '这张地图还没有地点' : '这个筛选下没有地点'}}</text>
        <view class="btn btn-primary" wx:if="{{!isPublicView}}" bindtap="goSearch">＋ 搜索添加地点</view>
        <view class="btn" wx:else bindtap="enterEntry">创建 / 加入地图</view>
      </view>
      <view
        wx:for="{{filtered}}"
        wx:key="id"
        class="place-item"
        data-id="{{item.id}}"
        bindtap="onTapPlace"
      >
        <view class="place-emoji" style="background: {{item.emojiColor}}22; border-color: {{item.emojiColor}}55;">{{item.emoji}}</view>
        <view class="place-main">
          <view class="place-name">
            <text class="place-name-text">{{item.name}}</text>
            <text wx:if="{{item.visited}}" class="visited-dot">●</text>
          </view>
          <view class="place-meta ellipsis">
            {{item.category}}{{item.added_by ? ' · ' + item.added_by : ''}}{{item.photo_count ? ' · 📷' + item.photo_count : ''}}{{item.comment_count ? ' · 💬' + item.comment_count : ''}}
          </view>
        </view>
        <view class="place-wish" wx:if="{{item.wishCount > 0}}">♡ {{item.wishCount}}</view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{nearbyOpen}}" class="modal-mask" bindtap="closeNearby">
    <view class="discover-sheet" catchtap="noop">
      <view class="sheet-head">
        <view>
          <view class="sheet-title">◎ 离我最近</view>
          <view class="sheet-sub">按当前位置的直线距离排序</view>
        </view>
        <view class="sheet-close" bindtap="closeNearby">✕</view>
      </view>
      <view wx:for="{{nearbyPlaces}}" wx:key="id" class="nearby-row" data-id="{{item.id}}" bindtap="openNearbyPlace">
        <text class="nearby-emoji">{{item.emoji}}</text>
        <view class="nearby-main">
          <text class="nearby-name">{{item.name}}</text>
          <text class="nearby-meta ellipsis">{{item.category}}{{item.address ? ' · ' + item.address : ''}}</text>
        </view>
        <text class="nearby-distance">{{item.distance}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{randomOpen}}" class="modal-mask" bindtap="closeRandom">
    <view class="discover-sheet random-sheet" catchtap="noop">
      <view class="sheet-close random-sheet-close" bindtap="closeRandom">✕</view>
      <view class="random-kicker">今天去哪里？</view>
      <view class="random-card {{randomDrawing ? 'random-card-drawing' : ''}}">
        <text class="random-emoji">{{randomPlace ? randomPlace.emoji : '🎲'}}</text>
        <text class="random-name">{{randomPlace ? randomPlace.name : '准备抽取'}}</text>
        <text class="random-meta">{{randomPlace ? randomPlace.category + (randomPlace.address ? ' · ' + randomPlace.address : '') : '从当前地图的全部地点中随机选择'}}</text>
      </view>
      <view class="random-actions">
        <view class="btn" bindtap="drawRandom">再抽一次</view>
        <view class="btn btn-primary {{randomDrawing ? 'btn-disabled' : ''}}" bindtap="openRandomPlace">查看地点</view>
      </view>
    </view>
  </view>
</view>
