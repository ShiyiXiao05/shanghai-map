.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}

.icon-factory {
  position: fixed;
  left: -100px;
  top: -100px;
  width: 44px;
  height: 44px;
}

/* 导航 */
.nav {
  background: var(--card);
  z-index: 10;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 24rpx;
}

.nav-title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  min-width: 0;
}

.nav-name {
  font-size: 32rpx;
  font-weight: 700;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-switch {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
  font-size: 26rpx;
}

.nav-btn-primary {
  background: var(--grad);
  border: none;
  color: #fff;
}

/* 地图 */
.map {
  width: 100%;
  flex: 1;
}

/* 底部面板 */
.panel {
  height: 46vh;
  display: flex;
  flex-direction: column;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
}

.filters {
  padding: 16rpx 24rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
  flex: none;
}

.chips-scroll {
  white-space: nowrap;
}

.chips {
  display: inline-flex;
  gap: 10rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 24rpx;
  background: var(--card);
}

.chip-on {
  color: var(--ink);
}

.filters-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

.toggle switch {
  transform: scale(0.7);
}

.sort {
  font-size: 24rpx;
  color: var(--ink-soft);
}

/* 列表 */
.place-scroll {
  flex: 1;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
}

.place-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
}

.place-item:active {
  background: var(--metro-soft);
}

.place-emoji {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border: 1rpx solid transparent;
}

.place-main {
  flex: 1;
  min-width: 0;
}

.place-name {
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.visited-dot {
  color: var(--brick);
  font-size: 18rpx;
}

.place-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
}

.place-wish {
  flex: none;
  font-size: 22rpx;
  color: var(--brick);
}

/* 空状态 */
.empty {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.empty-icon {
  font-size: 60rpx;
}
