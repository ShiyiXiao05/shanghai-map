.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--paper);
}

.icon-factory {
  position: fixed;
  left: -100px;
  top: -100px;
  width: 44px;
  height: 44px;
}

/* 导航 */
.nav {
  background: var(--card);
  z-index: 10;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-width: 0;
  padding: 12rpx 24rpx;
}

.nav-title {
  display: flex;
  align-items: baseline;
  flex: 1;
  gap: 12rpx;
  min-width: 0;
}

.nav-name {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.nav-switch {
  flex: none;
  font-size: 22rpx;
  color: var(--ink-soft);
  white-space: nowrap;
}

.nav-actions {
  display: flex;
  align-items: center;
  flex: none;
  gap: 16rpx;
  white-space: nowrap;
}

.nav-btn {
  flex: none;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
  font-size: 26rpx;
  white-space: nowrap;
}

.nav-btn-primary {
  background: var(--grad);
  border: none;
  color: #fff;
}

/* 地图 */
.map-wrap {
  position: relative;
  flex: 0.43;
  min-height: 0;
}

.map {
  width: 100%;
  height: 100%;
}

/* 全屏按钮（悬浮于地图右下角） */
.map-tools {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 5;
  display: flex;
  gap: 12rpx;
  max-width: calc(100% - 48rpx);
}

.map-tool-btn {
  flex: none;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
  font-size: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.18);
  white-space: nowrap;
}

.map-tool-random { border-color: var(--brick); }

/* 全屏态：铺满整屏，盖住导航与底部面板 */
.map-fs {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.map-divider {
  flex: none;
  height: 44px;
  text-align: center;
  color: var(--ink-faint);
  background: var(--paper);
  font-size: 20rpx;
}

.map-divider-grip {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  white-space: nowrap;
}

.map-fs .map-tools {
  bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.48);
}

.discover-sheet {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: var(--card);
}

.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.sheet-title { color: var(--ink); font-size: 32rpx; font-weight: 700; }
.sheet-sub { margin-top: 6rpx; color: var(--ink-faint); font-size: 22rpx; }
.sheet-close { padding: 12rpx; color: var(--ink-soft); font-size: 28rpx; }


.random-sheet { text-align: center; padding-top: 38rpx; }
.random-sheet-close { position: absolute; top: 14rpx; right: 18rpx; }
.random-kicker { margin-bottom: 20rpx; color: var(--ink-soft); font-size: 25rpx; }
/* 抽取范围 chips：复用首页 .chip 视觉，可换行居中 */
.random-cats { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; margin-bottom: 14rpx; }
.random-scope { margin-bottom: 18rpx; color: var(--ink-faint); font-size: 23rpx; }
.random-card {
  min-height: 300rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 28rpx;
  border: 1rpx solid var(--brick);
  border-radius: 16rpx;
  background: var(--paper);
}
.random-card-drawing { opacity: 0.82; transform: scale(0.99); }
.random-emoji { font-size: 76rpx; }
.random-name { display: block; max-width: 100%; overflow: hidden; color: var(--ink); font-size: 36rpx; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.random-meta { display: block; max-width: 100%; overflow: hidden; color: var(--ink-soft); font-size: 23rpx; white-space: nowrap; text-overflow: ellipsis; }
.random-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 22rpx; }
.btn-disabled { opacity: 0.5; }

/* 底部面板：border-box 让 safe-area 内边距算进 46vh，不把页面撑出屏幕 */
.panel {
  height: auto;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
}

.place-preview {
  flex: none;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  background: var(--paper);
}
.preview-emoji { flex: none; font-size: 40rpx; width: 56rpx; text-align: center; }
.preview-main { flex: 1; min-width: 0; }
.preview-name { color: var(--ink); font-size: 28rpx; font-weight: 700; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.preview-meta, .preview-desc { color: var(--ink-soft); font-size: 21rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.preview-desc { margin-top: 4rpx; }
.preview-close { flex: none; color: var(--ink-faint); padding: 8rpx; }
.preview-detail { flex: none; padding: 12rpx 18rpx; font-size: 24rpx; white-space: nowrap; }

.filters {
  padding: 16rpx 24rpx 8rpx;
  border-bottom: 1rpx solid var(--line);
  flex: none;
}

.chips-scroll {
  white-space: nowrap;
}

/* 关键词搜索框：贴在分类 chips 上方 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
}

.search-bar-icon {
  flex: none;
  font-size: 24rpx;
  color: var(--ink-faint);
}

.search-bar-input {
  flex: 1;
  min-width: 0;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: var(--ink);
}

.search-bar-clear {
  flex: none;
  padding: 6rpx 10rpx;
  color: var(--ink-faint);
  font-size: 26rpx;
}

.chips {
  display: inline-flex;
  gap: 10rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  color: var(--ink-soft);
  font-size: 24rpx;
  background: var(--card);
}

.chip-on {
  color: var(--ink);
}

.filters-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.toggle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
}

.toggle-switch {
  transform: scale(0.7);
}

.sort {
  font-size: 24rpx;
  color: var(--ink-soft);
}

/* 列表 */
.place-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
}

.place-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
}

.place-item:active {
  background: var(--metro-soft);
}

.place-emoji {
  flex: none;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  border: 1rpx solid transparent;
}

.place-main {
  flex: 1;
  min-width: 0;
}

.place-name {
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.place-name-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.visited-dot {
  color: var(--brick);
  font-size: 18rpx;
}

.place-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
}

.place-wish {
  flex: none;
  font-size: 22rpx;
  color: var(--brick);
}

/* 空状态 */
.empty {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
}

.empty-icon {
  font-size: 60rpx;
}

/* 「我的位置」标记模式提示条（不依赖定位接口） */
.map-mark-bar {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.16);
  z-index: 12;
}

.map-mark-text {
  font-size: 26rpx;
  color: var(--ink);
}

.map-mark-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.map-mark-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #fff;
  background: var(--brand, #2fa877);
}

.map-mark-btn-ghost {
  color: var(--ink-soft);
  background: rgba(0, 0, 0, 0.06);
}

