<view class="page">
  <view wx:if="{{mode === 'list'}}" class="body">
    <view class="title">我的地图</view>
    <view class="hint">当前：{{currentCode || '未加入'}}</view>
    <view
      wx:for="{{joinedMaps}}"
      wx:key="code"
      class="map-item {{item.code === currentCode ? 'map-item-on' : ''}}"
      data-code="{{item.code}}"
      bindtap="chooseMap"
    >
      <view class="map-name">{{item.name}}</view>
      <view class="map-code">{{item.code}}</view>
    </view>
    <view wx:if="{{joinedMaps.length === 0}}" class="empty">
      <text>还没有加入任何地图</text>
      <text class="empty-sub">下面创建一张，或输入同学的邀请码</text>
    </view>

    <view class="actions">
      <view class="btn btn-primary" data-mode="create" bindtap="switchMode">＋ 创建新地图</view>
      <view class="btn" data-mode="join" bindtap="switchMode">🔑 用邀请码加入</view>
    </view>
    <view class="actions" wx:if="{{joinedMaps.length > 0}}">
      <view class="btn" bindtap="goMemories">📷 回忆时间线</view>
      <view class="btn" bindtap="goPoster">🖼 分享海报</view>
    </view>
  </view>

  <view wx:elif="{{mode === 'create'}}" class="body">
    <view class="title">创建新地图</view>
    <view class="field">
      <text class="label">地图名称</text>
      <input class="input" value="{{name}}" maxlength="40" placeholder="比如：周末 citywalk" bindinput="onNameInput" />
    </view>
    <view class="field">
      <text class="label">你的昵称</text>
      <input class="input" value="{{nickname}}" maxlength="30" placeholder="同学怎么称呼你（选填）" bindinput="onNicknameInput" />
    </view>
    <view class="actions">
      <view class="btn" data-mode="list" bindtap="switchMode">返回</view>
      <view class="btn btn-primary" bindtap="createMap">创建，生成邀请码</view>
    </view>
  </view>

  <view wx:elif="{{mode === 'join'}}" class="body">
    <view class="title">用邀请码加入</view>
    <view class="field">
      <text class="label">邀请码</text>
      <input class="input input-code" value="{{code}}" maxlength="6" placeholder="同学分享的 6 位码" bindinput="onCodeInput" />
    </view>
    <view class="actions">
      <view class="btn" data-mode="list" bindtap="switchMode">返回</view>
      <view class="btn btn-primary" bindtap="joinMap">加入这张地图</view>
    </view>
  </view>

  <view wx:elif="{{mode === 'created'}}" class="body created">
    <view class="title">地图创建好了 🎉</view>
    <view class="hint">把邀请码发给同学，输入同样的码就能一起标记</view>
    <view class="invite-code">{{createdCode}}</view>
    <view class="actions">
      <view class="btn" bindtap="copyInvite">复制邀请码</view>
      <view class="btn btn-primary" bindtap="back">开始标记</view>
    </view>
  </view>
</view>
