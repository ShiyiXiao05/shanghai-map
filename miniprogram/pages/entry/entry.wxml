<page-meta page-style="{{themeStyle}}"/><view class="page">
  <view wx:if="{{mode === 'list'}}" class="body">
    <view class="title">我的地图</view>
    <view class="hint">当前：{{currentCode || '未加入'}}</view>
    <view
      wx:for="{{joinedMaps}}"
      wx:key="code"
      class="map-item {{item.code === currentCode ? 'map-item-on' : ''}}"
      data-code="{{item.code}}"
      bindtap="chooseMap"
    >
      <view class="map-name">{{item.name}}</view>
      <view class="map-code">{{item.code}}</view>
    </view>
    <view wx:if="{{joinedMaps.length === 0}}" class="empty">
      <text>还没有加入任何地图</text>
      <text class="empty-sub">下面创建一张，或输入同学的邀请码</text>
    </view>

    <view class="actions">
      <view class="btn btn-primary" data-mode="create" bindtap="switchMode">＋ 创建新地图</view>
      <view class="btn" data-mode="join" bindtap="switchMode">🔑 用邀请码加入</view>
    </view>
    <view class="actions" wx:if="{{joinedMaps.length > 0}}">
      <view class="btn" bindtap="goMemories">📷 回忆时间线</view>
      <view class="btn" bindtap="goPoster">🖼 分享海报</view>
    </view>
    <view class="section" wx:if="{{currentCode}}">
      <view class="section-title">当前地图设置</view>
      <view class="actions">
        <view class="btn" bindtap="startRename">✏️ 改名</view>
        <view class="btn" bindtap="exportMap">⇩ 导出 JSON</view>
        <view class="btn btn-danger" bindtap="deleteMap">🗑️ 删除整张地图</view>
      </view>
    </view>
    <view class="section">
      <view class="section-title">外观与版本</view>
      <picker range="{{themeModes}}" value="{{themeIndex}}" bindchange="onThemeChange"><view class="input">{{themeModes[themeIndex]}} ▾</view></picker>
      <view class="actions">
        <view class="btn" bindtap="goChangelog">更新日志</view>
        <view class="btn" bindtap="checkUpdates">检查更新 · {{version}}</view>
      </view>
    </view>
    <view class="actions">
      <view class="btn" bindtap="enterPublic">🌐 进入公共广场</view>
    </view>

    <!-- 我的身份：昵称可改、可退出登录（此前用户遇到昵称不一致时没有任何自救入口） -->
    <view class="section">
      <view class="section-title">我的身份</view>
      <view class="identity-row">
        <text class="identity-name">{{nickname || '未设置昵称'}}</text>
        <view class="btn btn-mini" bindtap="editNickname">修改昵称</view>
        <view class="btn btn-mini" bindtap="logout">退出登录</view>
      </view>
    </view>

    <!-- 当前地图管理：回收站与换邀请码，此前只能去网页版操作 -->
    <view class="section" wx:if="{{currentCode}}">
      <view class="section-title">地图管理 · {{currentCode}}</view>
      <view class="actions">
        <view class="btn" bindtap="goTrash">🗑 回收站</view>
        <view class="btn" bindtap="rekeyMap">🔄 换邀请码</view>
      </view>
      <view class="hint">换码后旧码立即失效；已加入的同学需要用新码重新加入（他们设备里存的是旧码），你自己会自动切换</view>
    </view>
  </view>

  <view wx:elif="{{mode === 'create'}}" class="body">
    <view class="title">创建新地图</view>
    <view class="field">
      <text class="label">地图名称</text>
      <input class="input" value="{{name}}" maxlength="40" placeholder="比如：周末 citywalk" bindinput="onNameInput" />
    </view>
    <view class="identity">📮 创建者将记录为「{{nickname || '登录昵称'}}」</view>
    <view class="actions">
      <view class="btn" data-mode="list" bindtap="switchMode">返回</view>
      <view class="btn btn-primary" bindtap="createMap">创建，生成邀请码</view>
    </view>
  </view>

  <view wx:elif="{{mode === 'join'}}" class="body">
    <view class="title">用邀请码加入</view>
    <view class="field">
      <text class="label">邀请码</text>
      <input class="input input-code" value="{{code}}" maxlength="6" placeholder="同学分享的 6 位码" bindinput="onCodeInput" />
    </view>
    <view class="actions">
      <view class="btn" data-mode="list" bindtap="switchMode">返回</view>
      <view class="btn btn-primary" bindtap="joinMap">加入这张地图</view>
    </view>
  </view>

  <view wx:elif="{{mode === 'rename'}}" class="body">
    <view class="title">修改地图名称</view>
    <view class="field"><text class="label">地图名称</text><input class="input" value="{{name}}" maxlength="40" bindinput="onNameInput" /></view>
    <view class="actions"><view class="btn" data-mode="list" bindtap="switchMode">取消</view><view class="btn btn-primary" bindtap="renameMap">保存</view></view>
  </view>

  <view wx:elif="{{mode === 'created'}}" class="body created">
    <view class="title">地图创建好了 🎉</view>
    <view class="hint">把邀请码发给同学，输入同样的码就能一起标记</view>
    <view class="invite-code">{{createdCode}}</view>
    <view class="hint">对方在小程序首页「切换 → 输入邀请码」即可加入</view>
    <view class="actions">
      <view class="btn" bindtap="copyInvite">复制邀请码</view>
      <view class="btn btn-primary" bindtap="back">开始标记</view>
    </view>
  </view>

  <nickname-modal show="{{nickModalShow}}" bind:confirm="onNickConfirm" bind:cancel="onNickCancel" />
</view>
