<view class="page">
  <view wx:if="{{loading}}" class="tip">加载中…</view>

  <block wx:elif="{{noMap}}">
    <view class="tip">加入一张地图后才有打卡记录。去过地点后在详情页点「✅ 打卡」，这里会攒下你们的回忆时间线。</view>
    <view class="actions">
      <view class="btn btn-primary" bindtap="goEntry">去创建 / 加入地图</view>
    </view>
  </block>

  <block wx:elif="{{error}}">
    <view class="tip">{{error}}</view>
    <view class="actions">
      <view class="btn" bindtap="retry">重试</view>
    </view>
  </block>

  <view wx:elif="{{groups.length === 0}}" class="tip">还没有打卡记录。去过地点后在详情页点「✅ 打卡」，这里就会攒下一份回忆时间线。</view>

  <view wx:for="{{groups}}" wx:for-item="group" wx:key="month" class="group">
    <view class="month">{{group.month}}</view>
    <view
      wx:for="{{group.items}}"
      wx:key="id"
      class="memory"
      data-id="{{item.id}}"
      bindtap="openDetail"
    >
      <view class="m-name">{{item.name}}</view>
      <view class="m-meta">{{item.date}}{{item.added_by ? ' · ' + item.added_by : ''}}{{item.address ? ' · ' + item.address : ''}}</view>
      <view class="m-photos" wx:if="{{item.photos.length > 0}}">
        <image
          wx:for="{{item.photos}}"
          wx:for-item="photo"
          wx:key="*this"
          class="m-photo"
          src="{{photo}}"
          mode="aspectFill"
          lazy-load
        />
      </view>
    </view>
  </view>
</view>
