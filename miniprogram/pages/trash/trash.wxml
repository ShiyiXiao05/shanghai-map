<view class="page">
  <view wx:if="{{loading}}" class="tip">⏳ 正在加载回收站…</view>

  <block wx:elif="{{noMap}}">
    <view class="tip">加入一张地图后才能使用回收站</view>
    <view class="actions">
      <view class="btn btn-primary" bindtap="goEntry">去加入地图</view>
    </view>
  </block>

  <block wx:elif="{{error}}">
    <view class="tip">⚠️ {{error}}</view>
    <view class="actions">
      <view class="btn btn-primary" bindtap="load">重试</view>
    </view>
  </block>

  <block wx:elif="{{items.length === 0}}">
    <view class="tip">🗑 回收站是空的{{'\n'}}删除的地点会在这里保留 30 天</view>
  </block>

  <block wx:else>
    <view class="hint">删除的地点在这里保留 30 天，期间可随时恢复；超期打开回收站时会自动彻底清理（含云端照片）。</view>
    <view class="item" wx:for="{{items}}" wx:key="id">
      <view class="item-main">
        <view class="item-name">{{item.name}}</view>
        <view class="item-meta">{{item.category}} · 删除于 {{item.deletedText}}</view>
        <view class="item-meta">剩余 {{item.daysLeft}} 天</view>
      </view>
      <view
        class="btn btn-mini {{item.restoring ? 'btn-busy' : ''}}"
        data-id="{{item.id}}"
        bindtap="restore"
      >{{item.restoring ? '恢复中…' : '恢复'}}</view>
    </view>
  </block>

  <view class="actions footer">
    <view class="btn" bindtap="back">返回</view>
  </view>
</view>
