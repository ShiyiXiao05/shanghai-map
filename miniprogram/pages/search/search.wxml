<view class="page">
  <view class="picker {{picked ? 'picker-on' : ''}}" bindtap="chooseLocation">
    <block wx:if="{{picked}}">
      <view class="picked-name">{{picked.name || '（未命名位置）'}}</view>
      <view class="picked-meta">{{picked.address}} · {{picked.latitude}}, {{picked.longitude}}</view>
      <view class="picked-tip">点击重新选择</view>
    </block>
    <block wx:else>
      <view class="picker-icon">🔍</view>
      <view class="picker-title">搜索地点，或在地图上选点</view>
      <view class="picker-tip">微信原生选点：搜「武康路」或直接点地图</view>
    </block>
  </view>

  <view class="field">
    <text class="label">分类</text>
    <picker range="{{categories}}" range-key="id" bindchange="onCategory">
      <view class="input">{{category}} ▾</view>
    </picker>
  </view>

  <view class="field">
    <text class="label">描述</text>
    <textarea class="input textarea" value="{{description}}" maxlength="500" placeholder="为什么想去、和谁去、要注意什么…" bindinput="onDescription" />
  </view>

  <view class="field-row">
    <view class="field field-half">
      <text class="label">人均</text>
      <input class="input" value="{{priceHint}}" maxlength="50" placeholder="比如 80" bindinput="onPriceHint" />
    </view>
    <view class="field field-half">
      <text class="label">营业时间</text>
      <input class="input" value="{{hours}}" maxlength="100" placeholder="11:00-22:00" bindinput="onHours" />
    </view>
  </view>

  <view class="field">
    <text class="label">标签</text>
    <input class="input" value="{{tags}}" maxlength="100" placeholder="选填，逗号分隔，比如：椒麻鸡,面馆" bindinput="onTags" />
  </view>

  <view class="identity" wx:if="{{nickname}}">📮 将以「{{nickname}}」的身份添加</view>
  <view class="identity" wx:else>📮 保存时需登录并确认昵称</view>

  <view class="btn btn-primary save" bindtap="save">{{saving ? '保存中…' : '保存到地图'}}</view>

  <view class="import-link" bindtap="goImport">📋 粘贴高德分享导入 →</view>

  <nickname-modal show="{{nickModalShow}}" bind:confirm="onNickConfirm" bind:cancel="onNickCancel" />
</view>
