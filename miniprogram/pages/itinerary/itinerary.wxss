.head {
  padding: 18px 20px 12px;
}

.title {
  font-size: 22px;
  font-weight: 700;
  color: var(--ink);
}

.sub {
  margin-top: 4px;
  font-size: 13px;
  color: var(--ink-soft);
}

.empty {
  padding: 40px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  color: var(--ink-soft);
}

.empty-icon {
  font-size: 30px;
}

.empty-sub {
  font-size: 12.5px;
  text-align: center;
}

.stop-list {
  padding: 0 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.stop {
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--card);
  padding: 12px 12px 10px;
}

.stop-head {
  display: flex;
  align-items: center;
  gap: 10px;
}

.stop-no {
  flex: none;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--metro);
  color: #fff;
  font-size: 13px;
  font-weight: 700;
}

.stop-emoji {
  flex: none;
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  border: 1px solid transparent;
  font-size: 15px;
}

.stop-name {
  flex: 1;
  min-width: 0;
  font-size: 15px;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stop-name.visited {
  color: var(--ink-soft);
}

.stop-ops {
  flex: none;
  display: flex;
  gap: 8px;
}

.op {
  min-width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  border: 1px solid var(--line);
  color: var(--ink);
  font-size: 14px;
}

.op-dis {
  opacity: 0.3;
}

.op-del {
  color: var(--brick);
  border-color: var(--line);
}

.stop-leg {
  margin: 6px 0 0 34px;
  font-size: 12px;
  color: var(--ink-soft);
}

.add {
  margin: 16px 16px 0;
  padding-top: 12px;
  border-top: 1px dashed var(--line);
}

.add-title {
  font-size: 13px;
  color: var(--ink-soft);
  margin-bottom: 10px;
}

.add-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.chip {
  max-width: 100%;
  padding: 7px 12px;
  border-radius: 999px;
  border: 1px solid var(--line);
  background: var(--card);
  color: var(--ink);
  font-size: 13px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.actions {
  display: flex;
  gap: 10px;
  padding: 18px 16px calc(24px + env(safe-area-inset-bottom));
}

.actions .btn {
  flex: 1;
}
