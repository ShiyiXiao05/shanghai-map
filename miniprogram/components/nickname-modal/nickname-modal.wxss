.nick-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.nick-card {
  width: 100%;
  max-width: 560rpx;
  background: var(--card);
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.35);
}

.nick-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.nick-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}

.nick-input {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
  color: var(--ink);
  font-size: 30rpx;
}

.nick-actions {
  margin-top: 32rpx;
  display: flex;
  gap: 20rpx;
}

.nick-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  color: var(--ink);
  font-size: 28rpx;
}

.nick-btn-primary {
  border: none;
  background: var(--grad);
  color: #ffffff;
}
