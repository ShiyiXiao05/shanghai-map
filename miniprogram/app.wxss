/* 全局样式：浅色（默认）/ 深色（东京夜）双主题，跟随系统 */

page {
  --paper: #f2f6f5;
  --card: #ffffff;
  --ink: #1f2d2a;
  --ink-soft: #5b6f6b;
  --ink-faint: #93a39d;
  --line: #dde7e4;
  --metro: #0f766e;
  --metro-soft: rgba(15, 118, 110, 0.1);
  --brick: #be4a43;
  --neon-a: #0f766e;
  --neon-b: #0891b2;
  --grad: linear-gradient(135deg, var(--neon-a), var(--neon-b));
  background: var(--paper);
  color: var(--ink);
  font-size: 28rpx;
}

@media (prefers-color-scheme: dark) {
  page {
    --paper: #171a1b;
    --card: #222627;
    --ink: #edf1ef;
    --ink-soft: #b1bdb8;
    --ink-faint: #8b9b93;
    --line: #3a4240;
    --metro: #78d6b0;
    --metro-soft: rgba(120, 214, 176, 0.1);
    --brick: #f58d83;
    --neon-a: #287a60;
    --neon-b: #397b8d;
    --grad: linear-gradient(135deg, var(--neon-a), var(--neon-b));
  }
}

/* 通用按钮与卡片 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.2;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--grad);
  border: none;
  color: #ffffff;
}

.btn-danger {
  color: var(--brick);
  border-color: var(--brick);
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
